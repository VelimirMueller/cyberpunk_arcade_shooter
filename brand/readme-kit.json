      {"title": "NEON ARENA", "text": "A bloom-soaked geometry shooter. Multi-stage boss fights, bullet hells, arcade pace."},
      {"title": "CRT LOOK", "text": "One hand-written WGSL shader: scanlines, vignette, barrel distortion. A quality tier per platform."},
      {"title": "RUNS ANYWHERE", "text": "Native on Vulkan, Metal or DirectX 12. In the browser via WASM. Keyboard only."}
    ]},
